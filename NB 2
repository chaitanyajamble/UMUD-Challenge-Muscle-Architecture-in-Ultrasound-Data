IMG_EXTS = (".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff")
 
 
def _index_by_stem(paths):
    
    index = {}
    for p in paths:
        stem = os.path.splitext(os.path.basename(p))[0]
        index[stem] = p
    return index
 
 
def _strip_known_suffixes(stem):
   
    candidates = {stem}
    for tok in ("_img", "_image", "img_", "image_", "_mask", "mask_", "_gt", "gt_"):
        if stem.startswith(tok):
            candidates.add(stem[len(tok):])
        if stem.endswith(tok):
            candidates.add(stem[: -len(tok)])
    return candidates
 
 
def list_pairs(img_dir, mask_dir):
    """Match images to masks by filename stem, naming variations.
 
    Strategy (in order):
      1. Exact stem match (image 'foo.png' <-> mask 'foo.png' or 'foo.<any_ext>').
      2. Stem match after stripping common '_img'/'_mask'/etc. suffixes.
      3. If neither yields any pairs but both folders have the same number of
         files, fall back to positional pairing after sorting both lists
         (works when files are consistently ordered/named e.g. 0001, 0002...).
    """
    img_paths = sorted([p for p in glob.glob(os.path.join(img_dir, "*"))
                         if os.path.splitext(p)[1].lower() in IMG_EXTS])
    mask_paths = sorted([p for p in glob.glob(os.path.join(mask_dir, "*"))
                          if os.path.splitext(p)[1].lower() in IMG_EXTS])
 
    if not img_paths:
        print(f"  [WARN] No image files found in {img_dir}")
        return []
    if not mask_paths:
        print(f"  [WARN] No mask files found in {mask_dir}")
        return []
 
    mask_index = _index_by_stem(mask_paths)
 
    pairs = []
    unmatched = []
    for ip in img_paths:
        stem = os.path.splitext(os.path.basename(ip))[0]
 
        # 1) exact stem match
        if stem in mask_index:
            pairs.append((ip, mask_index[stem]))
            continue
 
       
        found = None
        img_candidates = _strip_known_suffixes(stem)
 
        for cand in img_candidates:
            if cand in mask_index:
                found = mask_index[cand]
                break
 
        if found is None:
            for mstem, mpath in mask_index.items():
                mask_candidates = _strip_known_suffixes(mstem)
                if img_candidates & mask_candidates:  # any overlap
                    found = mpath
                    break
 
        if found is not None:
            pairs.append((ip, found))
        else:
            unmatched.append(ip)
 
   
    if len(pairs) == 0 and len(img_paths) == len(mask_paths):
        print(f"  [INFO] Falling back to positional (sorted-order) pairing for "
              f"{img_dir} <-> {mask_dir} ({len(img_paths)} files each).")
        pairs = list(zip(img_paths, mask_paths))
        unmatched = []
 
    if unmatched:
        print(f"  [WARN] {len(unmatched)}/{len(img_paths)} images in {img_dir} "
              f"had no matching mask (showing up to 3): {unmatched[:3]}")
 
    return pairs
 
 
class SegDataset(Dataset):
    def __init__(self, pairs, img_size=512, augment=False):
        self.pairs = pairs
        self.img_size = img_size
        self.augment = augment
 
    def __len__(self):
        return len(self.pairs)
 
    def __getitem__(self, idx):
        img_path, mask_path = self.pairs[idx]
        img = cv2.imread(img_path, cv2.IMREAD_GRAYSCALE)
        mask = cv2.imread(mask_path, cv2.IMREAD_GRAYSCALE)
 
        img = cv2.resize(img, (self.img_size, self.img_size), interpolation=cv2.INTER_LINEAR)
        mask = cv2.resize(mask, (self.img_size, self.img_size), interpolation=cv2.INTER_NEAREST)
        mask = (mask > 127).astype(np.float32)
 
        if self.augment:
            if random.random() < 0.5:  # horizontal flip
                img = np.fliplr(img).copy()
                mask = np.fliplr(mask).copy()
            if random.random() < 0.3:  # slight brightness jitter
                img = np.clip(img.astype(np.float32) * random.uniform(0.85, 1.15), 0, 255)
 
        img = img.astype(np.float32) / 255.0
        img_t = torch.from_numpy(img).unsqueeze(0)      # (1,H,W)
        mask_t = torch.from_numpy(mask).unsqueeze(0)     # (1,H,W)
        return img_t, mask_t
 
 
# --------------------------------------------------------------------------- #
# Model: U-Net
# --------------------------------------------------------------------------- #
class ConvBlock(nn.Module):
    def __init__(self, cin, cout):
        super().__init__()
        self.block = nn.Sequential(
            nn.Conv2d(cin, cout, 3, padding=1), nn.BatchNorm2d(cout), nn.ReLU(inplace=True),
            nn.Conv2d(cout, cout, 3, padding=1), nn.BatchNorm2d(cout), nn.ReLU(inplace=True),
        )
 
    def forward(self, x):
        return self.block(x)
 
 
class UNet(nn.Module):
    def __init__(self, in_ch=1, out_ch=1, base=32):
        super().__init__()
        self.enc1 = ConvBlock(in_ch, base)
        self.enc2 = ConvBlock(base, base * 2)
        self.enc3 = ConvBlock(base * 2, base * 4)
        self.enc4 = ConvBlock(base * 4, base * 8)
        self.pool = nn.MaxPool2d(2)
 
        self.bottleneck = ConvBlock(base * 8, base * 16)
 
        self.up4 = nn.ConvTranspose2d(base * 16, base * 8, 2, stride=2)
        self.dec4 = ConvBlock(base * 16, base * 8)
        self.up3 = nn.ConvTranspose2d(base * 8, base * 4, 2, stride=2)
        self.dec3 = ConvBlock(base * 8, base * 4)
        self.up2 = nn.ConvTranspose2d(base * 4, base * 2, 2, stride=2)
        self.dec2 = ConvBlock(base * 4, base * 2)
        self.up1 = nn.ConvTranspose2d(base * 2, base, 2, stride=2)
        self.dec1 = ConvBlock(base * 2, base)
 
        self.out_conv = nn.Conv2d(base, out_ch, 1)
 
    def forward(self, x):
        e1 = self.enc1(x)
        e2 = self.enc2(self.pool(e1))
        e3 = self.enc3(self.pool(e2))
        e4 = self.enc4(self.pool(e3))
        b = self.bottleneck(self.pool(e4))
 
        d4 = self.dec4(torch.cat([self.up4(b), e4], dim=1))
        d3 = self.dec3(torch.cat([self.up3(d4), e3], dim=1))
        d2 = self.dec2(torch.cat([self.up2(d3), e2], dim=1))
        d1 = self.dec1(torch.cat([self.up1(d2), e1], dim=1))
        return self.out_conv(d1)
 
 
def dice_loss(pred_logits, target, eps=1e-6):
    pred = torch.sigmoid(pred_logits)
    pred = pred.view(pred.size(0), -1)
    target = target.view(target.size(0), -1)
    inter = (pred * target).sum(dim=1)
    union = pred.sum(dim=1) + target.sum(dim=1)
    dice = (2 * inter + eps) / (union + eps)
    return 1 - dice.mean()
 
 
def combo_loss(pred_logits, target):
    bce = F.binary_cross_entropy_with_logits(pred_logits, target)
    return bce + dice_loss(pred_logits, target)
 
 
# --------------------------------------------------------------------------- #
# Training
# --------------------------------------------------------------------------- #
def train_one_model(pairs, name, epochs=CFG.EPOCHS):
    if len(pairs) < 2:
        raise RuntimeError(
            f"[{name}] Only {len(pairs)} image/mask pair(s) found — need at "
            f"least 2 to form a train/val split. Check list_pairs() matching."
        )
 
    pairs = list(pairs)
    random.shuffle(pairs)
    n_val = max(1, int(len(pairs) * CFG.VAL_FRAC))
    n_val = min(n_val, len(pairs) - 1)  # always leave at least 1 for training
    val_pairs, train_pairs = pairs[:n_val], pairs[n_val:]
 
    train_ds = SegDataset(train_pairs, CFG.IMG_SIZE, augment=True)
    val_ds = SegDataset(val_pairs, CFG.IMG_SIZE, augment=False)
    train_dl = DataLoader(train_ds, batch_size=CFG.BATCH_SIZE, shuffle=True,
                           num_workers=CFG.NUM_WORKERS, pin_memory=True)
    val_dl = DataLoader(val_ds, batch_size=CFG.BATCH_SIZE, shuffle=False,
                         num_workers=CFG.NUM_WORKERS, pin_memory=True)
 
    model = UNet(in_ch=1, out_ch=1, base=32).to(CFG.DEVICE)
    optimizer = torch.optim.AdamW(model.parameters(), lr=CFG.LR, weight_decay=1e-5)
    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=epochs)
 
    best_val = float("inf")
    best_path = f"{name}_best.pt"
 
    for epoch in range(epochs):
        model.train()
        train_loss = 0.0
        for imgs, masks in train_dl:
            imgs, masks = imgs.to(CFG.DEVICE), masks.to(CFG.DEVICE)
            optimizer.zero_grad()
            logits = model(imgs)
            loss = combo_loss(logits, masks)
            loss.backward()
            optimizer.step()
            train_loss += loss.item() * imgs.size(0)
        train_loss /= len(train_ds)
 
        model.eval()
        val_loss = 0.0
        with torch.no_grad():
            for imgs, masks in val_dl:
                imgs, masks = imgs.to(CFG.DEVICE), masks.to(CFG.DEVICE)
                logits = model(imgs)
                loss = combo_loss(logits, masks)
                val_loss += loss.item() * imgs.size(0)
        val_loss /= max(1, len(val_ds))
        scheduler.step()
 
        print(f"[{name}] epoch {epoch+1}/{epochs}  train_loss={train_loss:.4f}  val_loss={val_loss:.4f}")
 
        if val_loss < best_val:
            best_val = val_loss
            torch.save(model.state_dict(), best_path)
 
    model.load_state_dict(torch.load(best_path, map_location=CFG.DEVICE))
    return model
 
 
# --------------------------------------------------------------------------- #
# Inference helpers
# --------------------------------------------------------------------------- #
@torch.no_grad()
def predict_mask(model, img_path, img_size=CFG.IMG_SIZE, thresh=0.5):
    img = cv2.imread(img_path, cv2.IMREAD_GRAYSCALE)
    orig_h, orig_w = img.shape[:2]
    img_r = cv2.resize(img, (img_size, img_size), interpolation=cv2.INTER_LINEAR)
    img_t = torch.from_numpy(img_r.astype(np.float32) / 255.0).unsqueeze(0).unsqueeze(0).to(CFG.DEVICE)
    logits = model(img_t)
    prob = torch.sigmoid(logits)[0, 0].cpu().numpy()
    mask = (prob > thresh).astype(np.uint8)
    mask = cv2.resize(mask, (orig_w, orig_h), interpolation=cv2.INTER_NEAREST)
    return mask, (orig_h, orig_w)
 
 
def fit_line_to_component(component_mask):
    """Fit a line (vx, vy, x0, y0) to a binary component using cv2.fitLine."""
    ys, xs = np.nonzero(component_mask)
    if len(xs) < 2:
        return None
    pts = np.column_stack([xs, ys]).astype(np.float32)
    vx, vy, x0, y0 = cv2.fitLine(pts, cv2.DIST_L2, 0, 0.01, 0.01).flatten()
    return vx, vy, x0, y0
 
 
def line_angle_deg(vx, vy):
    """Angle of a direction vector relative to horizontal, in degrees [0,180)."""
    angle = math.degrees(math.atan2(vy, vx))
    return angle % 180
 
 
def perpendicular_distance_between_lines(line1, line2, img_shape):

    h, w = img_shape
    xc = w / 2.0
 
    def y_at_x(line, x):
        vx, vy, x0, y0 = line
        if abs(vx) < 1e-6:
            return y0
        t = (x - x0) / vx
        return y0 + t * vy
 
    y1 = y_at_x(line1, xc)
    y2 = y_at_x(line2, xc)
    raw_gap = abs(y2 - y1)
 
    # average angle of the two aponeurosis lines relative to horizontal
    a1 = math.atan2(line1[1], line1[0])
    a2 = math.atan2(line2[1], line2[0])
    avg_angle = (a1 + a2) / 2.0
    perpendicular_gap = raw_gap * math.cos(avg_angle)
    return abs(perpendicular_gap)
 
 
def measure_from_masks(apo_mask, fasc_mask):
   
    h, w = apo_mask.shape
 
    # --- Split aponeurosis mask into its connected components, keep 2 largest ---
    num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(apo_mask, connectivity=8)
    comp_sizes = [(i, stats[i, cv2.CC_STAT_AREA]) for i in range(1, num_labels)]
    comp_sizes.sort(key=lambda x: -x[1])
 
    if len(comp_sizes) < 2:
        return None  # can't find both aponeuroses
 
    top_two = comp_sizes[:2]
    comps = []
    for idx, _ in top_two:
        comp_mask = (labels == idx).astype(np.uint8)
        line = fit_line_to_component(comp_mask)
        if line is None:
            return None
        # mean y position, to distinguish superficial (upper) vs deep (lower)
        ys, _ = np.nonzero(comp_mask)
        comps.append((line, ys.mean()))
 
    comps.sort(key=lambda c: c[1])  # sort by mean y: index0 = superficial, index1 = deep
    superficial_line, _ = comps[0]
    deep_line, _ = comps[1]
 
    mt_px = perpendicular_distance_between_lines(superficial_line, deep_line, (h, w))
 
    # --- Fascicle line ---
    fasc_line = fit_line_to_component(fasc_mask)
    if fasc_line is None:
        return None
 
    vx_f, vy_f, x0_f, y0_f = fasc_line
    vx_d, vy_d, _, _ = deep_line
 
    # Pennation angle: angle between fascicle direction and deep aponeurosis direction
    dot = vx_f * vx_d + vy_f * vy_d
    dot = np.clip(dot, -1.0, 1.0)
    pa_deg = math.degrees(math.acos(abs(dot)))  # acute angle between the two lines
 
    # --- Fascicle length: length of fascicle segment clipped between the two aponeurosis lines ---
    ys_f, xs_f = np.nonzero(fasc_mask)
    if len(xs_f) == 0:
        return None
    y_min, y_max = ys_f.min(), ys_f.max()
 
    def x_at_y(line, y):
        vx, vy, x0, y0 = line
        if abs(vy) < 1e-6:
            return x0
        t = (y - y0) / vy
        return x0 + t * vx
 
    # project fascicle segment endpoints onto the fascicle's own line at the
    # y-range spanned by the two aponeuroses (approx superficial->deep)
    y_top = min(y_min, y_max)
    y_bot = max(y_min, y_max)
    x_top = x_at_y(fasc_line, y_top)
    x_bot = x_at_y(fasc_line, y_bot)
    fl_px = math.hypot(x_bot - x_top, y_bot - y_top)
 
    return pa_deg, fl_px, mt_px
 
 
