# Ensemble + TTA inference helper (shared by both branches)
def predict_ensemble(models, img_crop_gray, size=IMG_SIZE):
    h, w = img_crop_gray.shape[:2]
    inp = cv2.resize(img_crop_gray, (size, size), interpolation=cv2.INTER_AREA).astype(np.float32) / 255.0
    inp_flip = inp[:, ::-1].copy()
    batch = torch.from_numpy(np.stack([inp, inp_flip])).unsqueeze(1).float().to(DEVICE)

    probs_accum = np.zeros((size, size), dtype=np.float32)
    with torch.no_grad():
        for model in models:
            with autocast(enabled=(DEVICE.type == "cuda")):
                logits = model(batch)
            probs = torch.sigmoid(logits).float().cpu().numpy()
            probs_accum += probs[0, 0]
            probs_accum += probs[1, 0][:, ::-1]
    probs_accum /= (2 * len(models))
    return cv2.resize(probs_accum, (w, h), interpolation=cv2.INTER_LINEAR)
