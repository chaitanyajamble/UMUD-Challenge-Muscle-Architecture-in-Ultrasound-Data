# Geometric Measurement Extraction
def extract_mt_px(apo_prob, thresh=0.5, min_valid_cols=10):
    h, w = apo_prob.shape
    binm = (apo_prob > thresh).astype(np.uint8)
    sup_ys, deep_ys = np.full(w, np.nan), np.full(w, np.nan)
    for x in range(w):
        col = np.where(binm[:, x] > 0)[0]
        if len(col) == 0:
            continue
        splits = np.where(np.diff(col) > 1)[0]
        runs = np.split(col, splits + 1)
        if len(runs) >= 2:
            sup_ys[x] = runs[0].mean()
            deep_ys[x] = runs[-1].mean()
    valid = ~np.isnan(sup_ys) & ~np.isnan(deep_ys)
    if valid.sum() < min_valid_cols:
        return None
    thickness_px = float(np.nanmedian(deep_ys[valid] - sup_ys[valid]))
    return thickness_px, sup_ys, deep_ys, valid

def estimate_deep_line_angle(deep_ys, valid):
    xs = np.where(valid)[0].astype(np.float32)
    ys = deep_ys[valid].astype(np.float32)
    if len(xs) < 5:
        return 0.0
    slope = np.polyfit(xs, ys, 1)[0]
    return float(np.degrees(np.arctan(slope)))

def extract_pa_fl_px(fasc_prob, deep_angle_deg=0.0, thresh=0.5, min_pixels=15):
    ys, xs = np.where(fasc_prob > thresh)
    if len(xs) < min_pixels:
        return None
    pts = np.column_stack([xs, ys]).astype(np.float32)
    vx, vy, x0, y0 = cv2.fitLine(pts, cv2.DIST_L2, 0, 0.01, 0.01).flatten()
    fasc_angle = abs(np.degrees(np.arctan2(vy, vx)))
    if fasc_angle > 90:
        fasc_angle = 180 - fasc_angle
    pa_deg = float(np.clip(abs(fasc_angle - abs(deep_angle_deg)), 1.0, 45.0))
    proj = (xs - x0) * vx + (ys - y0) * vy
    length_px = float(proj.max() - proj.min())
    return pa_deg, length_px

records, fallback_log = [], []

for fpath in tqdm(test_files, desc="Ensemble inference + measurement", ncols=100):
    fname = fpath.name
    with Image.open(fpath) as im:
        img_np = np.asarray(im)

    px_per_cm, l, t, r, b = decode_hardware_scale(img_np, fname)
    mm_per_px = 10.0 / px_per_cm
    h_orig, w_orig = img_np.shape[:2]
    l, t, r, b = max(0, l), max(0, t), min(w_orig, r), min(h_orig, b)
    if r <= l + 40 or b <= t + 40:
        l, t, r, b = 0, 0, w_orig, h_orig
    crop = img_np[t:b, l:r]
    if crop.ndim == 3:
        crop_gray = cv2.cvtColor(crop, cv2.COLOR_RGB2GRAY) if crop.shape[2] == 3 else crop[:, :, 0]
    else:
        crop_gray = crop

    apo_prob = predict_ensemble(apo_models, crop_gray)
    fasc_prob = predict_ensemble(fasc_models, crop_gray)

    mt_res = extract_mt_px(apo_prob)
    if mt_res is None:
        prof = crop_gray.mean(axis=1).astype(np.float32)
        win = min(31, len(prof) - 1)
        win -= (win % 2 == 0)
        prof_s = savgol_filter(prof, max(win, 5), 2) if win >= 5 else prof
        sup_y = int(np.argmax(prof_s[:max(1, int(0.4 * len(prof_s)))]))
        deep_y = int(sup_y + 2.0 * px_per_cm)
        thickness_px = float(max(1.0, deep_y - sup_y))
        deep_angle = 0.0
        fallback_log.append((fname, "apo_fallback"))
    else:
        thickness_px, sup_ys, deep_ys, valid = mt_res
        deep_angle = estimate_deep_line_angle(deep_ys, valid)

    pa_fl_res = extract_pa_fl_px(fasc_prob, deep_angle_deg=deep_angle)
    if pa_fl_res is None:
        pa_deg = 17.0
        length_px = thickness_px / max(0.05, math.sin(math.radians(pa_deg)))
        fallback_log.append((fname, "fasc_fallback"))
    else:
        pa_deg, length_px = pa_fl_res

    mt_mm = thickness_px * mm_per_px
    fl_mm = length_px * mm_per_px

    # Physiological consistency clamp, applied per-scan using only that scan's own MT & PA.
    sin_pa = max(0.05, math.sin(math.radians(pa_deg)))
    implied_fl = mt_mm / sin_pa
    ratio = fl_mm / implied_fl if implied_fl > 0 else 1.0
    ratio_clipped = float(np.clip(ratio, 0.90, 1.22))
    fl_mm = implied_fl * ratio_clipped

    records.append({
        "image_id": fname,
        "pa_deg": round(float(np.clip(pa_deg, 5.0, 45.0)), 4),
        "fl_mm": round(float(np.clip(fl_mm, 30.0, 200.0)), 4),
        "mt_mm": round(float(np.clip(mt_mm, 10.0, 50.0)), 4),
    })

df_opt = pd.DataFrame(records)
print(f"Measurements extracted for {len(df_opt)} scans "
      f"({len(fallback_log)} used a heuristic fallback due to inconclusive segmentation).")
# Spatio-Temporal Cine-Loop Smoothing
df_opt = df_opt.sort_values("image_id").reset_index(drop=True)
SMOOTH_WINDOW = 5
for col in ["pa_deg", "fl_mm", "mt_mm"]:
    rolled = df_opt[col].rolling(window=SMOOTH_WINDOW, center=True, min_periods=1).median()
    df_opt[col] = (0.7 * df_opt[col] + 0.3 * rolled).round(4)

print("+----------------------------------------------------------------+")
print(f"| Cine-Loop Temporal Smoothing Applied  : {SMOOTH_WINDOW}-frame rolling median   |")
print(f"| Physiological Ratio Bound Enforced    : FL/(MT/sin(PA)) in [0.90, 1.22]  |")
print("+----------------------------------------------------------------+")
