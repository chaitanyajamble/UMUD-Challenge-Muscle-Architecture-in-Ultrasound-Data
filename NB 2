# Attention U-Net Architecture
class ConvBlock(nn.Module):
    def __init__(self, in_ch, out_ch, p_drop=0.0):
        super().__init__()
        self.block = nn.Sequential(
            nn.Conv2d(in_ch, out_ch, 3, padding=1, bias=False),
            nn.BatchNorm2d(out_ch), nn.ReLU(inplace=True),
            nn.Conv2d(out_ch, out_ch, 3, padding=1, bias=False),
            nn.BatchNorm2d(out_ch), nn.ReLU(inplace=True),
            nn.Dropout2d(p_drop) if p_drop > 0 else nn.Identity(),
        )
    def forward(self, x):
        return self.block(x)

class AttentionGate(nn.Module):
    def __init__(self, gate_ch, skip_ch, inter_ch):
        super().__init__()
        self.w_g = nn.Sequential(nn.Conv2d(gate_ch, inter_ch, 1), nn.BatchNorm2d(inter_ch))
        self.w_x = nn.Sequential(nn.Conv2d(skip_ch, inter_ch, 1), nn.BatchNorm2d(inter_ch))
        self.psi = nn.Sequential(nn.Conv2d(inter_ch, 1, 1), nn.BatchNorm2d(1), nn.Sigmoid())
        self.relu = nn.ReLU(inplace=True)
    def forward(self, g, x):
        psi = self.psi(self.relu(self.w_g(g) + self.w_x(x)))
        return x * psi

class AttentionUNet(nn.Module):
    def __init__(self, in_channels=1, out_channels=1, base_filters=32):
        super().__init__()
        f = base_filters
        self.enc1, self.enc2 = ConvBlock(in_channels, f), ConvBlock(f, f * 2)
        self.enc3, self.enc4 = ConvBlock(f * 2, f * 4), ConvBlock(f * 4, f * 8)
        self.pool = nn.MaxPool2d(2, 2)
        self.bottleneck = ConvBlock(f * 8, f * 16, p_drop=0.3)

        self.up4, self.att4 = nn.ConvTranspose2d(f * 16, f * 8, 2, stride=2), AttentionGate(f * 8, f * 8, f * 4)
        self.dec4 = ConvBlock(f * 16, f * 8)
        self.up3, self.att3 = nn.ConvTranspose2d(f * 8, f * 4, 2, stride=2), AttentionGate(f * 4, f * 4, f * 2)
        self.dec3 = ConvBlock(f * 8, f * 4)
        self.up2, self.att2 = nn.ConvTranspose2d(f * 4, f * 2, 2, stride=2), AttentionGate(f * 2, f * 2, f)
        self.dec2 = ConvBlock(f * 4, f * 2)
        self.up1, self.att1 = nn.ConvTranspose2d(f * 2, f, 2, stride=2), AttentionGate(f, f, max(1, f // 2))
        self.dec1 = ConvBlock(f * 2, f)
        self.head = nn.Conv2d(f, out_channels, 1)

    def forward(self, x):
        e1 = self.enc1(x)
        e2 = self.enc2(self.pool(e1))
        e3 = self.enc3(self.pool(e2))
        e4 = self.enc4(self.pool(e3))
        b  = self.bottleneck(self.pool(e4))

        d4 = self.up4(b);  d4 = self.dec4(torch.cat([d4, self.att4(d4, e4)], dim=1))
        d3 = self.up3(d4); d3 = self.dec3(torch.cat([d3, self.att3(d3, e3)], dim=1))
        d2 = self.up2(d3); d2 = self.dec2(torch.cat([d2, self.att2(d2, e2)], dim=1))
        d1 = self.up1(d2); d1 = self.dec1(torch.cat([d1, self.att1(d1, e1)], dim=1))
        return self.head(d1)
# Hybrid Loss, Metrics & Reusable K-Fold Trainer
def dice_coeff(logits, targets, eps=1e-6):
    probs = torch.sigmoid(logits).reshape(logits.size(0), -1)
    targets = targets.reshape(targets.size(0), -1)
    inter = (probs * targets).sum(1)
    union = probs.sum(1) + targets.sum(1)
    return ((2 * inter + eps) / (union + eps)).mean()

class HybridLoss(nn.Module):
    def __init__(self, pos_weight=4.0):
        super().__init__()
        self.pos_weight = pos_weight
    def forward(self, logits, targets):
        pw = torch.tensor(self.pos_weight, device=logits.device)
        bce = F.binary_cross_entropy_with_logits(logits, targets, pos_weight=pw)
        return bce + (1 - dice_coeff(logits, targets))

def train_kfold(pairs, task_name, n_folds=N_FOLDS, epochs=EPOCHS, base_filters=32, patience=8):
    kf = KFold(n_splits=n_folds, shuffle=True, random_state=SEED)
    indices = np.arange(len(pairs))
    fold_models, fold_histories = [], []

    for fold, (train_idx, val_idx) in enumerate(kf.split(indices)):
        print(f"\n=== {task_name} | Fold {fold + 1}/{n_folds} "
              f"(train={len(train_idx)}, val={len(val_idx)}) ===")
        train_pairs = [pairs[i] for i in train_idx]
        val_pairs   = [pairs[i] for i in val_idx]

        train_dl = DataLoader(SegDataset(train_pairs, train=True, seed=SEED + fold),
                               batch_size=BATCH_SIZE, shuffle=True, num_workers=2,
                               worker_init_fn=worker_init_fn, drop_last=True)
        val_dl   = DataLoader(SegDataset(val_pairs, train=False, seed=SEED + fold),
                               batch_size=BATCH_SIZE, shuffle=False, num_workers=2)

        model = AttentionUNet(base_filters=base_filters).to(DEVICE)
        opt = torch.optim.AdamW(model.parameters(), lr=LR, weight_decay=1e-4)
        sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=epochs)
        criterion = HybridLoss(pos_weight=4.0)
        scaler = GradScaler(enabled=(DEVICE.type == "cuda"))

        history = defaultdict(list)
        best_dice, best_state, bad_epochs = -1.0, None, 0

        for epoch in range(1, epochs + 1):
            model.train()
            tr_loss = tr_dice = 0.0
            n_batches = 0
            for imgs, masks in train_dl:
                imgs, masks = imgs.to(DEVICE), masks.to(DEVICE)
                opt.zero_grad()
                with autocast(enabled=(DEVICE.type == "cuda")):
                    logits = model(imgs)
                    loss = criterion(logits, masks)
                scaler.scale(loss).backward()
                scaler.step(opt)
                scaler.update()
                tr_loss += loss.item()
                tr_dice += dice_coeff(logits, masks).item()
                n_batches += 1
            sched.step()
            tr_loss /= max(1, n_batches)
            tr_dice /= max(1, n_batches)

            model.eval()
            va_loss = va_dice = 0.0
            n_val = 0
            with torch.no_grad():
                for imgs, masks in val_dl:
                    imgs, masks = imgs.to(DEVICE), masks.to(DEVICE)
                    with autocast(enabled=(DEVICE.type == "cuda")):
                        logits = model(imgs)
                        loss = criterion(logits, masks)
                    va_loss += loss.item()
                    va_dice += dice_coeff(logits, masks).item()
                    n_val += 1
            va_loss /= max(1, n_val)
            va_dice /= max(1, n_val)

            history["train_loss"].append(tr_loss); history["val_loss"].append(va_loss)
            history["train_dice"].append(tr_dice); history["val_dice"].append(va_dice)

            if va_dice > best_dice:
                best_dice = va_dice
                best_state = {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}
                bad_epochs = 0
            else:
                bad_epochs += 1

            if epoch == 1 or epoch % 5 == 0 or epoch == epochs:
                print(f"  epoch {epoch:3d}/{epochs} | train_loss={tr_loss:.4f} dice={tr_dice:.4f} "
                      f"| val_loss={va_loss:.4f} dice={va_dice:.4f}")
            if bad_epochs >= patience:
                print(f"  early stopping at epoch {epoch} (best val dice={best_dice:.4f})")
                break

        model.load_state_dict(best_state)
        model.eval()
        fold_models.append(model)
        fold_histories.append(history)
        print(f"  -> {task_name} fold {fold + 1} best val dice: {best_dice:.4f}")

    return fold_models, fold_histories
