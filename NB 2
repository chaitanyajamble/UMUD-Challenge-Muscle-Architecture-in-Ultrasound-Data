# Main pipeline
# --------------------------------------------------------------------------- #
def main():
    print("Device:", CFG.DEVICE)
 
    # 1) Build train pairs and train the two segmentation models
    apo_pairs = list_pairs(CFG.APO_IMG_DIR, CFG.APO_MASK_DIR)
    fasc_pairs = list_pairs(CFG.FASC_IMG_DIR, CFG.FASC_MASK_DIR)
    print(f"Found {len(apo_pairs)} aponeurosis pairs, {len(fasc_pairs)} fascicle pairs")
 
    if len(apo_pairs) == 0:
        raise RuntimeError(
            f"No image/mask pairs found for aponeurosis data.\n"
            f"  Checked images in: {CFG.APO_IMG_DIR}\n"
            f"  Checked masks in:  {CFG.APO_MASK_DIR}\n"
            f"Run this to inspect actual filenames and fix the matching logic "
            f"in list_pairs() if needed:\n"
            f"  print(os.listdir('{CFG.APO_IMG_DIR}')[:5])\n"
            f"  print(os.listdir('{CFG.APO_MASK_DIR}')[:5])"
        )
    if len(fasc_pairs) == 0:
        raise RuntimeError(
            f"No image/mask pairs found for fascicle data.\n"
            f"  Checked images in: {CFG.FASC_IMG_DIR}\n"
            f"  Checked masks in:  {CFG.FASC_MASK_DIR}\n"
            f"Run this to inspect actual filenames and fix the matching logic "
            f"in list_pairs() if needed:\n"
            f"  print(os.listdir('{CFG.FASC_IMG_DIR}')[:5])\n"
            f"  print(os.listdir('{CFG.FASC_MASK_DIR}')[:5])"
        )
 
    apo_model = train_one_model(apo_pairs, name="apo_unet")
    fasc_model = train_one_model(fasc_pairs, name="fasc_unet")
 
    apo_model.eval()
    fasc_model.eval()
 
    # 2) inference on all test images and compute geometry-based measurements
    test_paths = sorted(glob.glob(os.path.join(CFG.TEST_IMG_DIR, "*")))
    print(f"Found {len(test_paths)} test images")
 

    fallback_pa, fallback_fl, fallback_mt = 15.0, 25.0, 15.0
 
    rows = []
    for path in tqdm(test_paths, desc="Inference"):
        image_id = os.path.splitext(os.path.basename(path))[0]
        spacing = get_pixel_spacing(image_id)
 
        apo_mask, shape = predict_mask(apo_model, path)
        fasc_mask, _ = predict_mask(fasc_model, path)
 
        result = measure_from_masks(apo_mask, fasc_mask)
        if result is None:
            pa_deg, fl_mm, mt_mm = fallback_pa, fallback_fl, fallback_mt
        else:
            pa_deg, fl_px, mt_px = result
            fl_mm = fl_px * spacing
            mt_mm = mt_px * spacing
 
        rows.append({
            "image_id": image_id,
            "pa_deg": round(float(pa_deg), 2),
            "fl_mm": round(float(fl_mm), 2),
            "mt_mm": round(float(mt_mm), 2),
        })
 
    sub_df = pd.DataFrame(rows)
 
  
    if os.path.exists(CFG.SAMPLE_SUB):
        sample = pd.read_csv(CFG.SAMPLE_SUB)
        sub_df = sample[["image_id"]].merge(sub_df, on="image_id", how="left")
        sub_df[["pa_deg", "fl_mm", "mt_mm"]] = sub_df[["pa_deg", "fl_mm", "mt_mm"]].fillna(
            {"pa_deg": fallback_pa, "fl_mm": fallback_fl, "mt_mm": fallback_mt}
        )
 
    sub_df.to_csv(CFG.OUTPUT_SUB, index=False)
    print(f"Saved submission to {CFG.OUTPUT_SUB}")
    print(sub_df.head())
 
 
if __name__ == "__main__":
    main()
 
