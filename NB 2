    value_cols = [c for c in ["pa_deg", "fl_mm", "mt_mm"] if c in sub_cols]
    if not value_cols:
        raise KeyError(
            f"None of the expected value columns (pa_deg, fl_mm, mt_mm) were found in "
            f"sample_submission.csv columns {sub_cols}. This usually means the delimiter "
            f"sniffing above picked the wrong separator - inspect the raw file's header "
            f"line and adjust `detect_delimiter` if needed."
        )

    # sample_submission ids may be either the full filename ("IMG_00001.tif") or the
    # extension-less stem ("IMG_00001") - detect which one matches our predictions better.
    df_opt_keyed = df_opt.copy()
    df_opt_keyed["_stem"] = df_opt_keyed["image_id"].apply(lambda x: Path(x).stem)

    sample_ids = sample_df[id_col].astype(str)
    full_match_rate = sample_ids.isin(df_opt_keyed["image_id"]).mean()
    stem_match_rate = sample_ids.isin(df_opt_keyed["_stem"]).mean()
    key_col = "image_id" if full_match_rate >= stem_match_rate else "_stem"
    print(f"Matching sample_submission '{id_col}' against prediction key '{key_col}' "
          f"(match rate: {max(full_match_rate, stem_match_rate):.1%})")

   
    predicted_ids = pd.Index(df_opt_keyed[key_col].astype(str))
    sample_id_index = pd.Index(sample_ids.astype(str).values)
    all_ids = predicted_ids.union(sample_id_index, sort=False)
    all_ids = pd.Index(sorted(all_ids))  # deterministic, natural-sort-ish order

    n_template_only = len(sample_id_index.difference(predicted_ids))
    n_extra_predicted = len(predicted_ids.difference(sample_id_index))
    print(f"sample_submission.csv had {len(sample_id_index)} template row(s); "
          f"{len(predicted_ids)} test image(s) were actually predicted "
          f"({n_extra_predicted} beyond the template, {n_template_only} template id(s) "
          f"not among the predictions). Emitting {len(all_ids)} row(s) total.")

    lookup = df_opt_keyed.set_index(key_col)[["pa_deg", "fl_mm", "mt_mm"]]
    matched = lookup.reindex(all_ids)

    df_final = matched.reset_index().rename(columns={key_col: id_col, "index": id_col})
    df_final = df_final[[id_col] + value_cols]

    n_missing = int(df_final[value_cols].isnull().any(axis=1).sum())
    if n_missing > 0:
        print(f"WARNING: {n_missing} row(s) had no matching prediction; "
              f"filling with cohort medians as a last resort.")
        for col in value_cols:
            df_final[col] = df_final[col].fillna(df_opt[col].median())

    # Preserve sample_submission's column set/order; any columns beyond id + value
    # (unlikely for this competition) are carried over empty rather than dropped.
    for extra_col in sub_cols:
        if extra_col not in df_final.columns:
            df_final[extra_col] = sample_df[extra_col].iloc[0] if len(sample_df) else ""
    df_final = df_final[sub_cols]
