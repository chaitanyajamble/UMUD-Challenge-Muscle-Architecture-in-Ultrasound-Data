def resolve_base_dir(preferred: str) -> str:
    """Return a working dataset root, searching common ---- locations
    if the preferred path does not exist."""
    if os.path.isdir(preferred):
        return preferred

    logger.warning("Preferred dataset path not found: %s", preferred)
    search_roots = ["/----/input", "."]
    for root in search_roots:
        if not os.path.isdir(root):
            continue
        for name in os.listdir(root):
            if "umud" in name.lower():
                candidate = os.path.join(root, name)
                if os.path.isdir(candidate):
                    logger.info("Falling back to discovered dataset path: %s", candidate)
                    return candidate

    raise FileNotFoundError(
        f"Could not locate the UMUD dataset. Checked '{preferred}' and "
        f"searched {search_roots} for a folder containing 'umud'. Please "
        f"attach the competition dataset to this notebook/session."
    )


def find_directory(base_dir: str, keyword: str) -> Optional[str]:
    """Recursively find the first directory under base_dir whose name
    contains keyword (case-insensitive)."""
    keyword = keyword.lower()
    if os.path.isdir(base_dir) and keyword in os.path.basename(base_dir).lower():
        return base_dir
    for root, dirs, _ in os.walk(base_dir):
        for d in dirs:
            if keyword in d.lower():
                return os.path.join(root, d)
    return None


def list_images_recursive(directory: str) -> List[str]:
    if directory is None or not os.path.isdir(directory):
        return []
    paths = []
    for root, _, files in os.walk(directory):
        for f in files:
            if f.lower().endswith(VALID_EXTS):
                paths.append(os.path.join(root, f))
    return sorted(paths)


def match_image_mask_pairs(img_dir: str, mask_dir: str) -> Tuple[List[str], List[str]]:
    """Match image/mask files, tolerant of nested (e.g. per-subject)
    subfolders and minor naming differences. Relative path is tried
    first (most specific, avoids collisions when subfolder structure
    mirrors between the image and mask trees); bare filename is used as
    a fallback for flatter dataset layouts."""
    if img_dir is None or mask_dir is None:
        return [], []

    mask_by_relpath: Dict[str, str] = {}
    mask_by_name: Dict[str, str] = {}
    mask_by_stem: Dict[str, str] = {}
    for root, _, files in os.walk(mask_dir):
        for f in files:
            if f.lower().endswith(VALID_EXTS):
                full_path = os.path.join(root, f)
                rel = os.path.relpath(full_path, mask_dir)
                mask_by_relpath[rel] = full_path
                mask_by_name.setdefault(f, full_path)
                mask_by_stem.setdefault(os.path.splitext(f)[0], full_path)

    img_paths, mask_paths = [], []
    for root, _, files in os.walk(img_dir):
        for f in files:
            if not f.lower().endswith(VALID_EXTS):
                continue
            full_img_path = os.path.join(root, f)
            rel = os.path.relpath(full_img_path, img_dir)
            stem = os.path.splitext(f)[0]

            candidate = mask_by_relpath.get(rel) or mask_by_name.get(f) or mask_by_stem.get(stem)
            if candidate:
                img_paths.append(full_img_path)
                mask_paths.append(candidate)

    return img_paths, mask_paths


def hash_file_bytes(path: str, chunk_size: int = 65536) -> Optional[str]:
    """MD5 hash of a file's bytes, used only to flag duplicate training
    images (see the competition discussion notice about duplicated
    training samples). Never raises."""
    try:
        h = hashlib.md5()
        with open(path, "rb") as fh:
            while True:
                chunk = fh.read(chunk_size)
                if not chunk:
                    break
                h.update(chunk)
        return h.hexdigest()
    except Exception:
        return None


def deduplicate_pairs(img_paths: List[str], mask_paths: List[str]) -> Tuple[List[str], List[str], int]:
    """Drop pairs whose image content is an exact duplicate of an
    already-seen image, keeping the first occurrence. This only affects
    the internal train/validation split quality, never the test set."""
    seen = set()
    keep_img, keep_mask = [], []
    n_dupes = 0
    for ip, mp in zip(img_paths, mask_paths):
        digest = hash_file_bytes(ip)
        if digest is None:
            keep_img.append(ip)
            keep_mask.append(mp)
            continue
        if digest in seen:
            n_dupes += 1
            continue
        seen.add(digest)
        keep_img.append(ip)
        keep_mask.append(mp)
    return keep_img, keep_mask, n_dupes


def sniff_csv_delimiter(path: str) -> str:
    """Detect whether a CSV uses comma or semicolon separators."""
    try:
        with open(path, "r", newline="", encoding="utf-8", errors="ignore") as fh:
            sample = fh.readline()
        try:
            dialect = csv.Sniffer().sniff(sample, delimiters=",;")
            return dialect.delimiter
        except csv.Error:
            return ";" if sample.count(";") > sample.count(",") else ","
    except Exception:
        return ","


def load_sample_submission(base_dir: str) -> Tuple[Optional["pd.DataFrame"], str]:
    """Locate and load sample_submission.csv, auto-detecting its
    delimiter. Returns (dataframe_or_None, delimiter)."""
    candidates = glob.glob(os.path.join(base_dir, "**", "sample_submission*.csv"), recursive=True)
    if not candidates:
        logger.warning("sample_submission.csv not found under %s", base_dir)
        return None, ","

    path = candidates[0]
    delimiter = sniff_csv_delimiter(path)
    try:
        df = pd.read_csv(path, sep=delimiter)
    except Exception:
        try:
            df = pd.read_csv(path, sep=None, engine="python")
            delimiter = ","
        except Exception as exc:
            logger.error("Failed to parse sample submission at %s: %s", path, exc)
            return None, ","

    df.columns = [c.strip() for c in df.columns]
    logger.info(
        "Loaded sample submission: %s (%d rows, delimiter=%r, columns=%s)",
        path, len(df), delimiter, list(df.columns),
    )
    return df, delimiter


def find_metadata_csv(base_dir: str) -> Tuple[Optional["pd.DataFrame"], Optional[str]]:
    """Look for an accompanying CSV with a pixel-spacing / scale column
    that could be used for precise mm-per-pixel calibration."""
    spacing_keywords = ("spacing", "scale", "pixel", "mm_per_px", "resolution", "calib")
    for path in glob.glob(os.path.join(base_dir, "**", "*.csv"), recursive=True):
        name = os.path.basename(path).lower()
        if "submission" in name:
            continue
        try:
            df = pd.read_csv(path, nrows=5)
        except Exception:
            continue
        cols_lower = [c.lower() for c in df.columns]
        for kw in spacing_keywords:
            for i, col in enumerate(cols_lower):
                if kw in col:
                    try:
                        full_df = pd.read_csv(path)
                        logger.info(
                            "Found calibration metadata file '%s' (column '%s')",
                            path, df.columns[i],
                        )
                        return full_df, df.columns[i]
                    except Exception:
                        continue
    return None, None


