def run_eda(apo_imgs: List[str], apo_masks: List[str],
            fasc_imgs: List[str], fasc_masks: List[str],
            test_imgs: List[str], out_dir: str) -> None:
    """Generate summary statistics and diagnostic plots. Never raises;
    EDA failures are logged and skipped rather than aborting the run."""
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt

    logger.info("Running EDA (%d apo pairs, %d fasc pairs, %d test images)",
                len(apo_imgs), len(fasc_imgs), len(test_imgs))

    def _shape_of(path: str) -> Optional[Tuple[int, int]]:
        img = cv2.imread(path, cv2.IMREAD_GRAYSCALE)
        return None if img is None else img.shape

    def _mask_positive_ratio(path: str) -> Optional[float]:
        m = cv2.imread(path, cv2.IMREAD_GRAYSCALE)
        if m is None or m.size == 0:
            return None
        return float((m > 127).sum()) / m.size

    # --- 1. Dataset size --------------------------------
    _, _, n_dupes_apo = deduplicate_pairs(apo_imgs, apo_masks)
    _, _, n_dupes_fasc = deduplicate_pairs(fasc_imgs, fasc_masks)
    logger.info(
        "Duplicate images detected -> aponeurosis: %d / %d, fascicle: %d / %d",
        n_dupes_apo, len(apo_imgs), n_dupes_fasc, len(fasc_imgs),
    )

    # --- 2. Image dimension distributions ------------------------------------
    try:
        sample_n = min(200, len(apo_imgs))
        apo_shapes = [s for s in (_shape_of(p) for p in apo_imgs[:sample_n]) if s]
        sample_n = min(200, len(fasc_imgs))
        fasc_shapes = [s for s in (_shape_of(p) for p in fasc_imgs[:sample_n]) if s]
        sample_n = min(200, len(test_imgs))
        test_shapes = [s for s in (_shape_of(p) for p in test_imgs[:sample_n]) if s]

        fig, axes = plt.subplots(1, 3, figsize=(15, 4))
        for ax, shapes, title in zip(
            axes, [apo_shapes, fasc_shapes, test_shapes],
            ["Aponeurosis images", "Fascicle images", "Test images"],
        ):
            if shapes:
                heights = [s[0] for s in shapes]
                widths = [s[1] for s in shapes]
                ax.scatter(widths, heights, alpha=0.4, s=10)
            ax.set_title(title)
            ax.set_xlabel("width (px)")
            ax.set_ylabel("height (px)")
        fig.suptitle("Image resolution spread by source")
        fig.tight_layout()
        fig.savefig(os.path.join(out_dir, "01_image_dimensions.png"), dpi=110)
        plt.close(fig)
    except Exception as exc:
        logger.warning("EDA dimension plot failed: %s", exc)

    # --- 3. Mask positive-pixel ratio ----------------------
    try:
        sample_n = min(300, len(apo_masks))
        apo_ratios = [r for r in (_mask_positive_ratio(p) for p in apo_masks[:sample_n]) if r is not None]
        sample_n = min(300, len(fasc_masks))
        fasc_ratios = [r for r in (_mask_positive_ratio(p) for p in fasc_masks[:sample_n]) if r is not None]

        fig, ax = plt.subplots(figsize=(7, 4))
        if apo_ratios:
            ax.hist(apo_ratios, bins=30, alpha=0.6, label=f"aponeurosis (mean={np.mean(apo_ratios):.3%})")
        if fasc_ratios:
            ax.hist(fasc_ratios, bins=30, alpha=0.6, label=f"fascicle (mean={np.mean(fasc_ratios):.3%})")
        ax.set_xlabel("fraction of positive (foreground) pixels")
        ax.set_ylabel("count")
        ax.set_title("Mask foreground ratio: class imbalance check")
        ax.legend()
        fig.tight_layout()
        fig.savefig(os.path.join(out_dir, "02_mask_class_balance.png"), dpi=110)
        plt.close(fig)

        if fasc_ratios and np.mean(fasc_ratios) < 0.02:
            logger.info(
                "Fascicle masks cover only ~%.2f%% of pixels on average -> "
                "severe class imbalance, Dice+BCE loss is used to compensate.",
                100 * np.mean(fasc_ratios),
            )
    except Exception as exc:
        logger.warning("EDA class-balance plot failed: %s", exc)

    # --- 4. Sample image--------------------------------------
    try:
        fig, axes = plt.subplots(2, 2, figsize=(10, 10))
        if apo_imgs and apo_masks:
            img = cv2.imread(apo_imgs[0], cv2.IMREAD_GRAYSCALE)
            msk = cv2.imread(apo_masks[0], cv2.IMREAD_GRAYSCALE)
            axes[0, 0].imshow(img, cmap="gray")
            axes[0, 0].set_title(f"Aponeurosis image {img.shape if img is not None else 'NA'}")
            axes[0, 1].imshow(msk, cmap="magma")
            axes[0, 1].set_title("Aponeurosis mask")
        if fasc_imgs and fasc_masks:
            img = cv2.imread(fasc_imgs[0], cv2.IMREAD_GRAYSCALE)
            msk = cv2.imread(fasc_masks[0], cv2.IMREAD_GRAYSCALE)
            axes[1, 0].imshow(img, cmap="gray")
            axes[1, 0].set_title(f"Fascicle image {img.shape if img is not None else 'NA'}")
            axes[1, 1].imshow(msk, cmap="magma")
            axes[1, 1].set_title("Fascicle mask")
        for ax in axes.ravel():
            ax.axis("off")
        fig.tight_layout()
        fig.savefig(os.path.join(out_dir, "03_sample_pairs.png"), dpi=110)
        plt.close(fig)
    except Exception as exc:
        logger.warning("EDA sample overlay plot failed: %s", exc)

    # --- 5. Test-set mean brightness (train/test domain-gap sanity check) ----
    try:
        def _mean_intensity(path):
            img = cv2.imread(path, cv2.IMREAD_GRAYSCALE)
            return None if img is None else float(img.mean())

        sample_n = min(150, len(apo_imgs))
        train_int = [v for v in (_mean_intensity(p) for p in apo_imgs[:sample_n]) if v is not None]
        sample_n = min(150, len(test_imgs))
        test_int = [v for v in (_mean_intensity(p) for p in test_imgs[:sample_n]) if v is not None]

        fig, ax = plt.subplots(figsize=(7, 4))
        if train_int:
            ax.hist(train_int, bins=30, alpha=0.6, label="train (aponeurosis set)")
        if test_int:
            ax.hist(test_int, bins=30, alpha=0.6, label="test")
        ax.set_xlabel("mean pixel intensity (0-255)")
        ax.set_ylabel("count")
        ax.set_title("Train vs test brightness distribution")
        ax.legend()
        fig.tight_layout()
        fig.savefig(os.path.join(out_dir, "04_intensity_domain_gap.png"), dpi=110)
        plt.close(fig)
    except Exception as exc:
        logger.warning("EDA intensity plot failed: %s", exc)

    logger.info("EDA complete. Plots saved to %s", out_dir)


