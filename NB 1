class SegmentationDataset(Dataset):
    """Grayscale image/mask pairs, resized to a fixed square size.
    Corrupt or unreadable files are logged once and substituted with a
    blank sample so a single bad file cannot crash a training epoch."""

    def __init__(self, image_paths: List[str], mask_paths: List[str],
                 img_size: int, train: bool = True):
        self.image_paths = image_paths
        self.mask_paths = mask_paths
        self.img_size = img_size
        self.train = train
        self.transform = build_train_transform(img_size) if train else None
        self._warned = False

    def __len__(self) -> int:
        return len(self.image_paths)

    def _safe_read(self, idx: int) -> Tuple[Optional[np.ndarray], Optional[np.ndarray]]:
        try:
            img = cv2.imread(self.image_paths[idx], cv2.IMREAD_GRAYSCALE)
            mask = cv2.imread(self.mask_paths[idx], cv2.IMREAD_GRAYSCALE)
            if img is None or mask is None:
                return None, None
            if img.shape != mask.shape:
                mask = cv2.resize(mask, (img.shape[1], img.shape[0]), interpolation=cv2.INTER_NEAREST)
            return img, mask
        except Exception as exc:
            if not self._warned:
                logger.warning("Unreadable sample at index %d (%s): %s", idx, self.image_paths[idx], exc)
                self._warned = True
            return None, None

    def __getitem__(self, idx: int):
        img, mask = self._safe_read(idx)
        if img is None:
            # Fall back to a blank sample rather than raising mid-epoch.
            img = np.zeros((self.img_size, self.img_size), dtype=np.uint8)
            mask = np.zeros((self.img_size, self.img_size), dtype=np.uint8)
        else:
            if self.transform is not None:
                augmented = self.transform(image=img, mask=mask)
                img, mask = augmented["image"], augmented["mask"]
            elif self.train:
                img, mask = fallback_augment(img, mask, self.img_size)
            else:
                img = cv2.resize(img, (self.img_size, self.img_size))
                mask = cv2.resize(mask, (self.img_size, self.img_size), interpolation=cv2.INTER_NEAREST)

        img_t = torch.from_numpy(img.astype(np.float32) / 255.0).unsqueeze(0)
        mask_t = torch.from_numpy((mask > 127).astype(np.float32)).unsqueeze(0)
        return img_t, mask_t


class TestImageDataset(Dataset):
    """Loads test images for batched inference, keeping the original
    resolution so masks can be resized back for geometry extraction."""

    def __init__(self, image_records: List[Tuple[str, str]], img_size: int):
        self.records = image_records  # list of (path, image_id)
        self.img_size = img_size

    def __len__(self) -> int:
        return len(self.records)

    def __getitem__(self, idx: int):
        path, image_id = self.records[idx]
        img = cv2.imread(path, cv2.IMREAD_GRAYSCALE)
        if img is None:
            # Return a flagged blank sample; handled downstream via orig_h<=0.
            blank = np.zeros((self.img_size, self.img_size), dtype=np.float32)
            return torch.from_numpy(blank).unsqueeze(0), 0, 0, image_id, path
        orig_h, orig_w = img.shape
        resized = cv2.resize(img, (self.img_size, self.img_size)).astype(np.float32) / 255.0
        return torch.from_numpy(resized).unsqueeze(0), orig_h, orig_w, image_id, path


# ---------------------------------------------------------------------------
# Loss
# ---------------------------------------------------------------------------
class DiceBCELoss(nn.Module):
    """Combined Dice + BCE loss; implemented from scratch so training does
    not hard-depend on segmentation_models_pytorch's loss module."""

    def __init__(self, smooth: float = 1.0):
        super().__init__()
        self.smooth = smooth
        self.bce = nn.BCEWithLogitsLoss()

    def forward(self, logits: "torch.Tensor", targets: "torch.Tensor") -> "torch.Tensor":
        bce_loss = self.bce(logits, targets)
        probs = torch.sigmoid(logits)
        probs_flat = probs.reshape(probs.size(0), -1)
        targets_flat = targets.reshape(targets.size(0), -1)
        intersection = (probs_flat * targets_flat).sum(dim=1)
        dice = (2 * intersection + self.smooth) / (
            probs_flat.sum(dim=1) + targets_flat.sum(dim=1) + self.smooth
        )
        return bce_loss + (1 - dice.mean())


def dice_score(logits: "torch.Tensor", targets: "torch.Tensor", threshold: float = 0.5) -> float:
    with torch.no_grad():
        preds = (torch.sigmoid(logits) > threshold).float()
        preds_flat = preds.reshape(preds.size(0), -1)
        targets_flat = targets.reshape(targets.size(0), -1)
        intersection = (preds_flat * targets_flat).sum(dim=1)
        denom = preds_flat.sum(dim=1) + targets_flat.sum(dim=1)
        dice = (2 * intersection + 1.0) / (denom + 1.0)
        return float(dice.mean().item())


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
class ConvBlock(nn.Module):
    def __init__(self, in_ch: int, out_ch: int):
        super().__init__()
        self.block = nn.Sequential(
            nn.Conv2d(in_ch, out_ch, 3, padding=1),
            nn.BatchNorm2d(out_ch),
            nn.ReLU(inplace=True),
            nn.Conv2d(out_ch, out_ch, 3, padding=1),
            nn.BatchNorm2d(out_ch),
            nn.ReLU(inplace=True),
        )

    def forward(self, x):
        return self.block(x)


class SimpleUNet(nn.Module):
    """Compact from-scratch U-Net used as a fully offline fallback when
    segmentation_models_pytorch (and its pretrained encoder weights) is
    unavailable. No external downloads required."""

    def __init__(self, in_channels: int = 1, out_channels: int = 1, base: int = 32):
        super().__init__()
        self.enc1 = ConvBlock(in_channels, base)
        self.enc2 = ConvBlock(base, base * 2)
        self.enc3 = ConvBlock(base * 2, base * 4)
        self.enc4 = ConvBlock(base * 4, base * 8)
        self.pool = nn.MaxPool2d(2)

        self.bottleneck = ConvBlock(base * 8, base * 16)

        self.up4 = nn.ConvTranspose2d(base * 16, base * 8, 2, stride=2)
        self.dec4 = ConvBlock(base * 16, base * 8)
        self.up3 = nn.ConvTranspose2d(base * 8, base * 4, 2, stride=2)
        self.dec3 = ConvBlock(base * 8, base * 4)
        self.up2 = nn.ConvTranspose2d(base * 4, base * 2, 2, stride=2)
        self.dec2 = ConvBlock(base * 4, base * 2)
        self.up1 = nn.ConvTranspose2d(base * 2, base, 2, stride=2)
        self.dec1 = ConvBlock(base * 2, base)

        self.out_conv = nn.Conv2d(base, out_channels, 1)

    def forward(self, x):
        e1 = self.enc1(x)
        e2 = self.enc2(self.pool(e1))
        e3 = self.enc3(self.pool(e2))
        e4 = self.enc4(self.pool(e3))
        b = self.bottleneck(self.pool(e4))

        d4 = self.dec4(torch.cat([self.up4(b), e4], dim=1))
        d3 = self.dec3(torch.cat([self.up3(d4), e3], dim=1))
        d2 = self.dec2(torch.cat([self.up2(d3), e2], dim=1))
        d1 = self.dec1(torch.cat([self.up1(d2), e1], dim=1))

        return self.out_conv(d1)


def build_segmentation_model() -> "nn.Module":
    """Preferred: ResNet34-encoder U-Net with ImageNet weights via
    segmentation_models_pytorch. Falls back to a from-scratch U-Net if
    the package or its pretrained weights cannot be obtained (e.g. no
    internet access at runtime)."""
    if HAS_SMP:
        try:
            model = smp.Unet(
                encoder_name="resnet34",
                encoder_weights="imagenet",
                in_channels=1,
                classes=1,
            )
            logger.info("Using segmentation_models_pytorch U-Net (ResNet34, ImageNet weights).")
            return model.to(DEVICE)
        except Exception as exc:
            logger.warning("Falling back to SimpleUNet: could not build smp.Unet (%s)", exc)

    logger.info("Using dependency-free SimpleUNet (trained from scratch).")
    return SimpleUNet(in_channels=1, out_channels=1).to(DEVICE)


# ---------------------------------------------------------------------------
# Training
# ---------------------------------------------------------------------------
def make_group_kfold_indices(n_samples: int, n_folds: int, seed: int) -> List[Tuple[np.ndarray, np.ndarray]]:
    """Simple shuffled K-fold split (used for cross-validation when
    Config.N_FOLDS > 1)."""
    rng = np.random.RandomState(seed)
    indices = rng.permutation(n_samples)
    folds = np.array_split(indices, n_folds)
    splits = []
    for i in range(n_folds):
        val_idx = folds[i]
        train_idx = np.concatenate([folds[j] for j in range(n_folds) if j != i])
        splits.append((train_idx, val_idx))
    return splits


def train_segmentation_model(
    name: str,
    img_paths: List[str],
    mask_paths: List[str],
    cfg: Config,
) -> str:
    """Trains a binary segmentation model and returns the path to the
    best checkpoint on disk. Uses a single holdout split by default;
    set cfg.N_FOLDS > 1 to run proper k-fold cross-validation (the fold
    with the best validation Dice is kept for inference)."""
    checkpoint_path = os.path.join(cfg.MODEL_DIR, f"best_{name}_unet.pth")

    if len(img_paths) == 0:
        logger.error("No training pairs found for '%s'; skipping training.", name)
        return checkpoint_path

    n = len(img_paths)
    n_folds = max(1, cfg.N_FOLDS)
    if n_folds == 1:
        rng = np.random.RandomState(cfg.RANDOM_SEED)
        idx = rng.permutation(n)
        val_size = max(1, int(n * cfg.VAL_FRACTION))
        splits = [(idx[val_size:], idx[:val_size])]
    else:
        splits = make_group_kfold_indices(n, n_folds, cfg.RANDOM_SEED)

    best_overall_dice = -1.0
    criterion = DiceBCELoss()
    use_amp = DEVICE.type == "cuda"
    scaler = torch.cuda.amp.GradScaler(enabled=use_amp)

    for fold_i, (train_idx, val_idx) in enumerate(splits):
        logger.info(
            "[%s] fold %d/%d -> %d train / %d val samples",
            name, fold_i + 1, n_folds, len(train_idx), len(val_idx),
        )

        train_imgs = [img_paths[i] for i in train_idx]
        train_masks = [mask_paths[i] for i in train_idx]
        val_imgs = [img_paths[i] for i in val_idx]
        val_masks = [mask_paths[i] for i in val_idx]

        train_ds = SegmentationDataset(train_imgs, train_masks, cfg.IMG_SIZE, train=True)
        val_ds = SegmentationDataset(val_imgs, val_masks, cfg.IMG_SIZE, train=False)

        train_loader = DataLoader(
            train_ds, batch_size=cfg.BATCH_SIZE, shuffle=True,
            num_workers=cfg.NUM_WORKERS, pin_memory=(DEVICE.type == "cuda"),
            drop_last=len(train_ds) > cfg.BATCH_SIZE,
        )
        val_loader = DataLoader(
            val_ds, batch_size=cfg.BATCH_SIZE, shuffle=False,
            num_workers=cfg.NUM_WORKERS, pin_memory=(DEVICE.type == "cuda"),
        )

        model = build_segmentation_model()
        optimizer = torch.optim.AdamW(model.parameters(), lr=cfg.LEARNING_RATE,
                                       weight_decay=cfg.WEIGHT_DECAY)
        scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=cfg.EPOCHS)

        best_fold_dice = -1.0
        for epoch in range(1, cfg.EPOCHS + 1):
            t0 = time.time()
            model.train()
            running_loss = 0.0
            for images, masks in train_loader:
                images = images.to(DEVICE, non_blocking=True)
                masks = masks.to(DEVICE, non_blocking=True)

                optimizer.zero_grad(set_to_none=True)
                with torch.cuda.amp.autocast(enabled=use_amp):
                    outputs = model(images)
                    loss = criterion(outputs, masks)

                scaler.scale(loss).backward()
                scaler.step(optimizer)
                scaler.update()
                running_loss += loss.item() * images.size(0)

            scheduler.step()
            train_loss = running_loss / max(1, len(train_ds))

            model.eval()
            val_loss, val_dice, n_val = 0.0, 0.0, 0
            with torch.no_grad():
                for images, masks in val_loader:
                    images = images.to(DEVICE, non_blocking=True)
                    masks = masks.to(DEVICE, non_blocking=True)
                    with torch.cuda.amp.autocast(enabled=use_amp):
                        outputs = model(images)
                        loss = criterion(outputs, masks)
                    val_loss += loss.item() * images.size(0)
                    val_dice += dice_score(outputs, masks) * images.size(0)
                    n_val += images.size(0)

            val_loss = val_loss / max(1, n_val)
            val_dice = val_dice / max(1, n_val)
            elapsed = time.time() - t0

            logger.info(
                "[%s] fold %d epoch %02d/%d | train_loss=%.4f val_loss=%.4f val_dice=%.4f (%.1fs)",
                name, fold_i + 1, epoch, cfg.EPOCHS, train_loss, val_loss, val_dice, elapsed,
            )

            if val_dice > best_fold_dice:
                best_fold_dice = val_dice
                if val_dice > best_overall_dice:
                    best_overall_dice = val_dice
                    torch.save(model.state_dict(), checkpoint_path)

        del model, optimizer, scheduler
        gc.collect()
        if DEVICE.type == "cuda":
            torch.cuda.empty_cache()

    logger.info("[%s] training complete. Best validation Dice: %.4f (checkpoint: %s)",
                name, best_overall_dice, checkpoint_path)
    return checkpoint_path


def load_model_checkpoint(checkpoint_path: str) -> "nn.Module":
    model = build_segmentation_model()
    if os.path.isfile(checkpoint_path):
        try:
            state = torch.load(checkpoint_path, map_location=DEVICE)
            model.load_state_dict(state)
            logger.info("Loaded checkpoint: %s", checkpoint_path)
        except Exception as exc:
            logger.warning("Could not load checkpoint %s (%s); using untrained weights.",
                            checkpoint_path, exc)
    else:
        logger.warning("Checkpoint not found at %s; using untrained weights.", checkpoint_path)
    model.eval()
    return model


# ---------------------------------------------------------------------------
# Calibration (pixels -> millimetres)
# ---------------------------------------------------------------------------
def estimate_ruler_spacing(image_path: str, default_mm_per_px: float) -> float:
    """Detect bright ruler tick marks in the image margins and estimate
    mm-per-pixel from their spacing (1 cm between major ticks is a common
    MSK ultrasound convention). Falls back to the documented default if
    detection is inconclusive or scipy is unavailable."""
    try:
        img = cv2.imread(image_path, cv2.IMREAD_GRAYSCALE)
        if img is None:
            return default_mm_per_px
        h, w = img.shape
        rois = [img[:, : int(w * 0.15)], img[:, int(w * 0.85):]]

        for roi in rois:
            _, thresh = cv2.threshold(roi, 200, 255, cv2.THRESH_BINARY)
            row_sums = thresh.sum(axis=1)

            if HAS_SCIPY_SIGNAL:
                peaks, _ = scipy_signal.find_peaks(row_sums, height=255, distance=30)
            else:
                peaks = np.where(row_sums > row_sums.max() * 0.9)[0] if row_sums.max() > 0 else np.array([])

            if len(peaks) >= 2:
                diffs = np.diff(np.sort(peaks))
                median_diff = float(np.median(diffs))
                if 30 < median_diff < 300:
                    return 10.0 / median_diff  # 1 cm between major ticks

        return default_mm_per_px
    except Exception:
        return default_mm_per_px


def build_calibration_lookup(base_dir: str, cfg: Config) -> Dict[str, float]:
    """Returns a mapping {image_id/filename: mm_per_pixel} sourced from
    an explicit metadata file if one exists in the dataset."""
    lookup: Dict[str, float] = {}
    metadata_df, spacing_col = find_metadata_csv(base_dir)
    if metadata_df is not None and spacing_col is not None and "image_id" in metadata_df.columns:
        for _, row in metadata_df.iterrows():
            try:
                value = float(row[spacing_col])
                if value > 0 and not math.isnan(value):
                    lookup[str(row["image_id"])] = value
            except (TypeError, ValueError):
                continue
        logger.info("Loaded %d per-image calibration values from metadata.", len(lookup))
    else:
        logger.info(
            "No calibration metadata file found; mm/px will be estimated per-image via "
            "ruler-tick detection, with a fixed fallback of %.4f mm/px.",
            cfg.DEFAULT_MM_PER_PIXEL,
        )
    return lookup


def get_mm_per_pixel(image_id: str, image_path: str, lookup: Dict[str, float], cfg: Config) -> float:
    if image_id in lookup:
        return lookup[image_id]
    return estimate_ruler_spacing(image_path, cfg.DEFAULT_MM_PER_PIXEL)


# ---------------------------------------------------------------------------
# Geometry: mask -> (pa_deg, fl_mm, mt_mm)
# ---------------------------------------------------------------------------
def _skeletonize(binary_mask: np.ndarray) -> np.ndarray:
    if HAS_SKIMAGE:
        return skimage_morphology.skeletonize(binary_mask > 0)
    # Cheap fallback: thin via repeated erosion (coarser than true
    # skeletonization but keeps the pipeline functional offline).
    mask = (binary_mask > 0).astype(np.uint8)
    kernel = np.ones((3, 3), np.uint8)
    thinned = cv2.erode(mask, kernel, iterations=1)
    return thinned > 0


def _fit_line_angle_and_points(ys: np.ndarray, xs: np.ndarray) -> Tuple[float, float, float]:
    """Fit a line to a point set, returning (slope, intercept_x, intercept_y)
    via cv2.fitLine for numerical stability on near-vertical lines."""
    pts = np.column_stack((xs, ys)).astype(np.float32)
    vx, vy, cx, cy = cv2.fitLine(pts, cv2.DIST_L2, 0, 0.01, 0.01).flatten()
    slope = float(vy) / (float(vx) + 1e-8)
    return slope, float(cx), float(cy)


def extract_architecture_parameters(
    apo_mask: np.ndarray,
    fasc_mask: np.ndarray,
    cfg: Config,
) -> Tuple[float, float, float]:
    """Given binary aponeurosis and fascicle masks at the ORIGINAL image
    resolution, compute (pa_deg, fl_mm_in_pixels, mt_mm_in_pixels) -- the
    caller applies the mm-per-pixel calibration afterwards. Returns
    physiologically clipped fallback values if the masks do not contain
    enough structure to measure.
    """
    h, w = apo_mask.shape

    # --- Aponeuroses: pick the two largest connected components ------------
    num_labels_a, labels_a, stats_a, _ = cv2.connectedComponentsWithStats(
        apo_mask.astype(np.uint8), connectivity=8
    )
    areas_a = sorted(
        ((i, stats_a[i, cv2.CC_STAT_AREA]) for i in range(1, num_labels_a)),
        key=lambda t: t[1], reverse=True,
    )

    mt_pixels = 0.0
    slope_deep = 0.0
    have_apo = len(areas_a) >= 2

    if have_apo:
        l1, l2 = areas_a[0][0], areas_a[1][0]
        skel1 = _skeletonize(labels_a == l1)
        skel2 = _skeletonize(labels_a == l2)
        y1, x1 = np.where(skel1)
        y2, x2 = np.where(skel2)

        if len(y1) >= 2 and len(y2) >= 2:
            s1, cx1, cy1 = _fit_line_angle_and_points(y1, x1)
            s2, cx2, cy2 = _fit_line_angle_and_points(y2, x2)

            mid_x = w / 2.0
            y_mid_1 = s1 * (mid_x - cx1) + cy1
            y_mid_2 = s2 * (mid_x - cx2) + cy2
            mt_pixels = abs(y_mid_1 - y_mid_2)
            slope_deep = s1 if y_mid_1 > y_mid_2 else s2
        else:
            have_apo = False

    # --- Fascicles: weighted average orientation of top components ---------
    fasc_skel = (_skeletonize(fasc_mask > 0)).astype(np.uint8)
    num_labels_f, labels_f, stats_f, _ = cv2.connectedComponentsWithStats(fasc_skel, connectivity=8)

    abs_angles, rel_angles, weights = [], [], []
    for i in range(1, num_labels_f):
        if stats_f[i, cv2.CC_STAT_AREA] <= cfg.FASC_MIN_COMPONENT_AREA:
            continue
        yf, xf = np.where(labels_f == i)
        if len(yf) < cfg.FASC_MIN_COMPONENT_AREA:
            continue
        slope_f, _, _ = _fit_line_angle_and_points(yf, xf)

        abs_angle = abs(math.degrees(math.atan(slope_f)))
        rel_tan = abs((slope_f - slope_deep) / (1 + slope_f * slope_deep + 1e-8))
        rel_angle = math.degrees(math.atan(rel_tan))

        abs_angles.append(abs_angle)
        rel_angles.append(rel_angle)
        weights.append(len(yf))

    if abs_angles:
        order = np.argsort(weights)[::-1][:3]
        top_w = np.array(weights)[order]
        pa_deg_abs = float(np.average(np.array(abs_angles)[order], weights=top_w))
        pa_deg_rel = float(np.average(np.array(rel_angles)[order], weights=top_w))
    else:
        pa_deg_abs = abs(math.degrees(math.atan(slope_deep))) + 15.0 if have_apo else cfg.FALLBACK_PA_DEG
        pa_deg_rel = 15.0

    pa_deg_rel = float(np.clip(pa_deg_rel, cfg.PA_MIN_DEG, cfg.PA_MAX_DEG))
    pa_deg_abs = float(np.clip(pa_deg_abs, 0.0, 90.0))

    if mt_pixels > 0:
        fl_pixels = mt_pixels / math.sin(math.radians(pa_deg_rel))
    else:
        fl_pixels = 0.0

    if not have_apo or mt_pixels <= 0:
        return cfg.FALLBACK_PA_DEG, None, None  # caller substitutes mm fallbacks

    return pa_deg_abs, fl_pixels, mt_pixels


# ---------------------------------------------------------------------------
# Inference
# ---------------------------------------------------------------------------
@torch.no_grad()
def predict_masks_batched(
    model: "nn.Module",
    records: List[Tuple[str, str]],
    cfg: Config,
    threshold: float,
    use_tta: bool,
) -> Dict[str, Tuple[np.ndarray, int, int]]:
    """Runs batched inference for one model over all test images.
    Returns {image_id: (binary_mask_at_original_resolution, orig_h, orig_w)}."""
    dataset = TestImageDataset(records, cfg.IMG_SIZE)
    loader = DataLoader(
        dataset, batch_size=cfg.INFER_BATCH_SIZE, shuffle=False,
        num_workers=cfg.NUM_WORKERS, pin_memory=(DEVICE.type == "cuda"),
    )

    outputs: Dict[str, Tuple[np.ndarray, int, int]] = {}
    use_amp = DEVICE.type == "cuda"

    for batch_imgs, orig_hs, orig_ws, image_ids, _paths in loader:
        batch_imgs = batch_imgs.to(DEVICE, non_blocking=True)
        with torch.cuda.amp.autocast(enabled=use_amp):
            logits = model(batch_imgs)
            probs = torch.sigmoid(logits)
            if use_tta:
                flipped_logits = model(torch.flip(batch_imgs, dims=[3]))
                flipped_probs = torch.flip(torch.sigmoid(flipped_logits), dims=[3])
                probs = (probs + flipped_probs) / 2.0

        probs = probs.squeeze(1).float().cpu().numpy()

        for i in range(probs.shape[0]):
            image_id = image_ids[i]
            orig_h, orig_w = int(orig_hs[i]), int(orig_ws[i])
            if orig_h <= 0 or orig_w <= 0:
                outputs[image_id] = (None, 0, 0)
                continue
            mask_small = (probs[i] > threshold).astype(np.uint8) * 255
            mask_orig = cv2.resize(mask_small, (orig_w, orig_h), interpolation=cv2.INTER_NEAREST)
            outputs[image_id] = (mask_orig, orig_h, orig_w)

    del loader, dataset
    gc.collect()
    if DEVICE.type == "cuda":
        torch.cuda.empty_cache()
    return outputs


def match_test_file(image_id: str, candidates_by_key: Dict[str, str]) -> Optional[str]:
    """Robustly resolve a sample-submission image_id to an actual file on
    disk, tolerating extension and case/prefix differences (the sample
    submission may reference IDs like 'image_00001' while files on disk
    are named e.g. 'IMG_00001.tif')."""
    if image_id in candidates_by_key:
        return candidates_by_key[image_id]

    stem = os.path.splitext(image_id)[0]
    variants = {
        stem,
        stem.lower(),
        stem.upper(),
        stem.replace("image_", "IMG_"),
        stem.replace("IMG_", "image_"),
        stem.replace("image", "IMG"),
        stem.replace("IMG", "image"),
    }
    for v in variants:
        if v in candidates_by_key:
            return candidates_by_key[v]
    return None


def run_inference(base_dir: str, cfg: Config,
                   apo_ckpt: str, fasc_ckpt: str) -> "pd.DataFrame":
    test_dir = find_directory(base_dir, "test")
    test_paths = list_images_recursive(test_dir) if test_dir else []
    if not test_paths:
        raise FileNotFoundError(f"No test images found under {base_dir} (looked for a 'test*' folder).")

    logger.info("Found %d test images under %s", len(test_paths), test_dir)

    candidates_by_key: Dict[str, str] = {}
    for p in test_paths:
        stem = os.path.splitext(os.path.basename(p))[0]
        candidates_by_key[os.path.basename(p)] = p
        candidates_by_key.setdefault(stem, p)

    sample_sub, delimiter = load_sample_submission(base_dir)
    if sample_sub is not None and "image_id" in sample_sub.columns:
        required_ids = sample_sub["image_id"].astype(str).tolist()
        output_columns = list(sample_sub.columns)
    else:
        required_ids = [os.path.splitext(os.path.basename(p))[0] for p in test_paths]
        output_columns = ["image_id", "pa_deg", "fl_mm", "mt_mm"]

    records: List[Tuple[str, str]] = []
    unresolved = 0
    for image_id in required_ids:
        path = match_test_file(image_id, candidates_by_key)
        if path is None:
            unresolved += 1
            continue
        records.append((path, image_id))

    if unresolved:
        logger.warning(
            "%d/%d required image_ids could not be matched to a file on disk; "
            "fallback predictions will be used for those rows.",
            unresolved, len(required_ids),
        )

    apo_model = load_model_checkpoint(apo_ckpt)
    fasc_model = load_model_checkpoint(fasc_ckpt)

    logger.info("Running batched segmentation inference (aponeurosis model)...")
    apo_results = predict_masks_batched(apo_model, records, cfg, cfg.APO_MASK_THRESHOLD, cfg.USE_TTA)
    del apo_model
    gc.collect()
    if DEVICE.type == "cuda":
        torch.cuda.empty_cache()

    logger.info("Running batched segmentation inference (fascicle model)...")
    fasc_results = predict_masks_batched(fasc_model, records, cfg, cfg.FASC_MASK_THRESHOLD, cfg.USE_TTA)
    del fasc_model
    gc.collect()
    if DEVICE.type == "cuda":
        torch.cuda.empty_cache()

    calibration_lookup = build_calibration_lookup(base_dir, cfg)

    resolved_ids = {image_id for _, image_id in records}
    path_by_id = {image_id: path for path, image_id in records}

    rows = []
    n_fallback = 0
    for image_id in required_ids:
        if image_id not in resolved_ids:
            rows.append({
                "image_id": image_id,
                "pa_deg": cfg.FALLBACK_PA_DEG,
                "fl_mm": cfg.FALLBACK_FL_MM,
                "mt_mm": cfg.FALLBACK_MT_MM,
            })
            n_fallback += 1
            continue

        apo_mask, oh, ow = apo_results.get(image_id, (None, 0, 0))
        fasc_mask, _, _ = fasc_results.get(image_id, (None, 0, 0))

        if apo_mask is None or fasc_mask is None or oh == 0 or ow == 0:
            rows.append({
                "image_id": image_id,
                "pa_deg": cfg.FALLBACK_PA_DEG,
                "fl_mm": cfg.FALLBACK_FL_MM,
                "mt_mm": cfg.FALLBACK_MT_MM,
            })
            n_fallback += 1
            continue

        try:
            pa_deg, fl_pixels, mt_pixels = extract_architecture_parameters(apo_mask, fasc_mask, cfg)
        except Exception as exc:
            logger.warning("Geometry extraction failed for %s (%s); using fallback values.", image_id, exc)
            pa_deg, fl_pixels, mt_pixels = cfg.FALLBACK_PA_DEG, None, None

        if fl_pixels is None or mt_pixels is None:
            rows.append({
                "image_id": image_id,
                "pa_deg": round(float(pa_deg), 3),
                "fl_mm": cfg.FALLBACK_FL_MM,
                "mt_mm": cfg.FALLBACK_MT_MM,
            })
            n_fallback += 1
            continue

        mm_per_px = get_mm_per_pixel(image_id, path_by_id[image_id], calibration_lookup, cfg)
        mt_mm = float(np.clip(mt_pixels * mm_per_px, cfg.MT_MIN_MM, cfg.MT_MAX_MM))
        fl_mm = float(np.clip(fl_pixels * mm_per_px, cfg.FL_MIN_MM, cfg.FL_MAX_MM))

        rows.append({
            "image_id": image_id,
            "pa_deg": round(float(pa_deg), 3),
            "fl_mm": round(fl_mm, 3),
            "mt_mm": round(mt_mm, 3),
        })

    if n_fallback:
        logger.warning("%d/%d rows used fallback predictions (unreadable image or empty masks).",
                        n_fallback, len(required_ids))

    result_df = pd.DataFrame(rows)
    if "image_id" in output_columns and set(output_columns) - {"image_id", "pa_deg", "fl_mm", "mt_mm"}:
        # Preserve any extra columns present in a non-standard sample submission.
        for col in output_columns:
            if col not in result_df.columns:
                result_df[col] = sample_sub[col].values if sample_sub is not None else np.nan
    result_df = result_df[[c for c in output_columns if c in result_df.columns]]

    return result_df, delimiter, sample_sub


# ---------------------------------------------------------------------------
# Submission validation & writing
# ---------------------------------------------------------------------------
def validate_submission(df: "pd.DataFrame", sample_sub: Optional["pd.DataFrame"]) -> None:
    required_cols = {"image_id", "pa_deg", "fl_mm", "mt_mm"}
    missing = required_cols - set(df.columns)
    if missing:
        raise ValueError(f"Submission is missing required columns: {missing}")

    if df["image_id"].duplicated().any():
        raise ValueError("Submission contains duplicate image_id values.")

    numeric_cols = ["pa_deg", "fl_mm", "mt_mm"]
    if df[numeric_cols].isna().any().any():
        raise ValueError("Submission contains NaN values in prediction columns.")

    if not np.isfinite(df[numeric_cols].to_numpy(dtype=float)).all():
        raise ValueError("Submission contains non-finite (inf) values in prediction columns.")

    if sample_sub is not None and "image_id" in sample_sub.columns:
        expected_ids = set(sample_sub["image_id"].astype(str))
        actual_ids = set(df["image_id"].astype(str))
        if expected_ids != actual_ids:
            missing_ids = expected_ids - actual_ids
            extra_ids = actual_ids - expected_ids
            raise ValueError(
                f"image_id mismatch vs sample_submission: "
                f"{len(missing_ids)} missing, {len(extra_ids)} unexpected."
            )
        if len(df) != len(sample_sub):
            raise ValueError(
                f"Row count mismatch: submission has {len(df)} rows, "
                f"sample_submission has {len(sample_sub)} rows."
            )

    logger.info("Submission validation passed: %d rows, columns=%s", len(df), list(df.columns))


def write_submission(df: "pd.DataFrame", path: str, delimiter: str) -> None:
    df.to_csv(path, index=False, sep=delimiter)
    logger.info("Submission written to %s (delimiter=%r)", path, delimiter)


# ---------------------------------------------------------------------------
# Main pipeline
# ---------------------------------------------------------------------------
def main() -> None:
    start_time = time.time()
    logger.info("Device: %s", DEVICE)

    try:
        base_dir = resolve_base_dir(CFG.BASE_DIR)
    except FileNotFoundError as exc:
        logger.error(str(exc))
        sys.exit(1)

    apo_img_dir = find_directory(base_dir, "apo_img")
    apo_mask_dir = find_directory(base_dir, "apo_mask")
    fasc_img_dir = find_directory(base_dir, "fasc_img")
    fasc_mask_dir = find_directory(base_dir, "fasc_mask")

    apo_imgs, apo_masks = match_image_mask_pairs(apo_img_dir, apo_mask_dir)
    fasc_imgs, fasc_masks = match_image_mask_pairs(fasc_img_dir, fasc_mask_dir)
    logger.info("Matched pairs -> aponeurosis: %d, fascicle: %d", len(apo_imgs), len(fasc_imgs))

    test_dir = find_directory(base_dir, "test")
    test_imgs = list_images_recursive(test_dir) if test_dir else []
    logger.info("Test images found: %d", len(test_imgs))

    if CFG.RUN_EDA:
        try:
            run_eda(apo_imgs, apo_masks, fasc_imgs, fasc_masks, test_imgs, CFG.EDA_DIR)
        except Exception as exc:
            logger.warning("EDA stage failed and was skipped: %s", exc)

    apo_ckpt = os.path.join(CFG.MODEL_DIR, "best_aponeurosis_unet.pth")
    fasc_ckpt = os.path.join(CFG.MODEL_DIR, "best_fascicle_unet.pth")

    if CFG.RUN_TRAINING:
        # Remove exact-duplicate training images (see competition discussion
        # notice) so the internal validation split is not contaminated.
        apo_imgs_dedup, apo_masks_dedup, n_dupe_apo = deduplicate_pairs(apo_imgs, apo_masks)
        fasc_imgs_dedup, fasc_masks_dedup, n_dupe_fasc = deduplicate_pairs(fasc_imgs, fasc_masks)
        if n_dupe_apo or n_dupe_fasc:
            logger.info("Removed %d duplicate aponeurosis and %d duplicate fascicle training pairs.",
                        n_dupe_apo, n_dupe_fasc)

        try:
            apo_ckpt = train_segmentation_model("aponeurosis", apo_imgs_dedup, apo_masks_dedup, CFG)
        except Exception as exc:
            logger.error("Aponeurosis model training failed: %s", exc)

        try:
            fasc_ckpt = train_segmentation_model("fascicle", fasc_imgs_dedup, fasc_masks_dedup, CFG)
        except Exception as exc:
            logger.error("Fascicle model training failed: %s", exc)
    else:
        logger.info("RUN_TRAINING=False -> skipping training, using existing checkpoints if present.")

    try:
        submission_df, delimiter, sample_sub = run_inference(base_dir, CFG, apo_ckpt, fasc_ckpt)
    except Exception as exc:
        logger.error("Inference failed: %s", exc)
        sys.exit(1)

    try:
        validate_submission(submission_df, sample_sub)
    except ValueError as exc:
        logger.error("Submission failed validation: %s", exc)
        sys.exit(1)

    write_submission(submission_df, CFG.OUTPUT_CSV, delimiter)

    elapsed_min = (time.time() - start_time) / 60.0
    logger.info("Pipeline complete in %.1f minutes.", elapsed_min)
    logger.info("Preview:\n%s", submission_df.head().to_string(index=False))


if __name__ == "__main__":
    main()
