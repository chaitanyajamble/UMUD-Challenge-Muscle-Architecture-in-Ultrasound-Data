# Augmentation
# ---------------------------------------------------------------------------
def build_train_transform(img_size: int):
    if HAS_ALBUMENTATIONS:
        return albumentations.Compose([
            albumentations.Resize(img_size, img_size),
            albumentations.HorizontalFlip(p=0.5),
            albumentations.Affine(scale=(0.9, 1.1), translate_percent=(-0.05, 0.05),
                                   rotate=(-15, 15), p=0.5),
            albumentations.RandomBrightnessContrast(p=0.3),
        ])
    return None


def fallback_augment(img: np.ndarray, mask: np.ndarray, img_size: int) -> Tuple[np.ndarray, np.ndarray]:
    """Minimal dependency-free augmentation used only when
    albumentations could not be imported/installed."""
    img = cv2.resize(img, (img_size, img_size))
    mask = cv2.resize(mask, (img_size, img_size), interpolation=cv2.INTER_NEAREST)

    if np.random.rand() < 0.5:
        img = np.ascontiguousarray(img[:, ::-1])
        mask = np.ascontiguousarray(mask[:, ::-1])

    if np.random.rand() < 0.3:
        alpha = 1.0 + np.random.uniform(-0.2, 0.2)  # contrast
        beta = np.random.uniform(-15, 15)  # brightness
        img = np.clip(img.astype(np.float32) * alpha + beta, 0, 255).astype(np.uint8)

    return img, mask


