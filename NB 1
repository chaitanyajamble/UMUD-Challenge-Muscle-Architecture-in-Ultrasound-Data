def _ensure_optional_package(module, pip_name: str):
    """
    Attempt a one-time quiet pip install for an optional but strongly
    preferred package (albumentations, segmentation-models-pytorch,
    scikit-image, scipy). Never raises; returns the (possibly still None)
    module.
    """
    if module is not None:
        return module
    try:
        import subprocess

        subprocess.run(
            [sys.executable, "-m", "pip", "install", "-q", pip_name],
            timeout=180,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return _try_import(pip_name.replace("-", "_"))
    except Exception:
        return None


